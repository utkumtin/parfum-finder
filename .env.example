# Copy this file to .env and fill in your own values. .env is gitignored,
# so real credentials never get committed.
#
# Enables the Google Sheets wishlist integration ([w] in the TUI) without
# having to pass --sheet-credentials/--sheet-id/--sheet-worksheet every run.

# Path to the Google service account JSON key.
PARFUM_SHEET_CREDENTIALS=

# The wishlist spreadsheet's ID or full URL.
PARFUM_SHEET_ID=

# Worksheet (tab) name inside the spreadsheet.
PARFUM_SHEET_WORKSHEET=
