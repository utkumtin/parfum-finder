# Copy to .env.local. The same value has to reach the backend, which reads it
# from PARFUM_FINDER_TOKEN:
#
#   PARFUM_FINDER_TOKEN=dev-token uv run uvicorn parfum_finder.api:app --port 8000
#   npm run dev
#
# Only for development. The packaged app generates a random token per process
# and injects it into the window instead.
VITE_AUTH_TOKEN=dev-token
