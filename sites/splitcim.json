{
  "schema_version": 1,
  "id": "splitcim",
  "name": "Splitçim",
  "base_url": "https://www.splitcim.com",
  "platform": "ideasoft",
  "strategy": "httpx",
  "search": {
    "url_template": "{base_url}/arama/{query}",
    "result_item": ".showcase",
    "result_url": ".showcase-title a::attr(href)",
    "result_title": ".showcase-title a::text"
  },
  "variant_rules": {
    "size_from": "variant_label",
    "size_pattern": "(\\d+[.,]?\\d*)\\s*(ml|cc)",
    "exclude_keywords": ["Tester", "Full Şişe", "Orijinal Şişe", "Kutulu", "Set"],
    "max_size_ml": 30
  },
  "shipping": {
    "free_shipping_threshold_kurus": 125000,
    "shipping_cost_kurus": 15000,
    "notes": "1250TL üzeri kargo bedava, altında 150TL. (Kargo bedelleri güncel olmayabilir, lütfen siteyi kontrol ediniz.)"
  },
  "discovered_at": "2026-08-10T07:21:31Z",
  "needs_review": []
}
