{
  "schema_version": 1,
  "name": "woocommerce",
  "fingerprint": {
    "any": ["woocommerce", "wp-content/plugins/woocommerce"]
  },
  "defaults": {
    "extraction": "embedded_json",
    "out_of_stock": "p.stock.out-of-stock",
    "search": {
      "url_template": "{base_url}/?s={query}&post_type=product"
    },
    "embedded_json": {
      "source": "attribute",
      "selector": "[data-product_variations]",
      "attribute": "data-product_variations",
      "field_map": {
        "size_raw": "attributes.attribute_pa_hacim",
        "price": "display_price",
        "in_stock": "is_in_stock",
        "sku": "sku"
      }
    }
  }
}
